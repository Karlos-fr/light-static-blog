---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import { getAbsoluteUrl, getCanonicalUrl, getPath } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  previousUrl?: string;
  nextUrl?: string;
  image?: string;
  publishedTime?: Date;
  modifiedTime?: Date;
  authorName?: string;
  tags?: string[];
}

const {
  title,
  description = '',
  type = 'website',
  structuredData,
  previousUrl,
  nextUrl,
  image,
  publishedTime,
  modifiedTime,
  authorName,
  tags = [],
} = Astro.props as Props;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const socialImageUrl = image
  ? getAbsoluteUrl(image)
  : getAbsoluteUrl(siteConfig.socialImage);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="fr" data-theme={siteConfig.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script src={getPath('scripts/color-mode-init.js')} is:inline></script>
    <link rel="stylesheet" href={getPath('styles/theme.css')} />
    <script src={getPath('scripts/color-mode-toggle.js')} defer is:inline></script>
    <script src={getPath('scripts/code-block-enhancements.js')} defer is:inline></script>
    <link rel="canonical" href={canonicalUrl} />
    {previousUrl ? <link rel="prev" href={previousUrl} /> : null}
    {nextUrl ? <link rel="next" href={nextUrl} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {type === 'article' && publishedTime ? (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    ) : null}
    {type === 'article' && modifiedTime ? (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    ) : null}
    {type === 'article' && authorName ? (
      <meta property="article:author" content={authorName} />
    ) : null}
    {type === 'article' ? tags.map((tag) => (
      <meta property="article:tag" content={tag} />
    )) : null}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={title} />
    {serializedStructuredData ? (
      <script type="application/ld+json" set:html={serializedStructuredData} is:inline />
    ) : null}
    <link rel="alternate" type="application/rss+xml" title="Flux RSS" href={getAbsoluteUrl('rss.xml')} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={getAbsoluteUrl('sitemap.xml')} />
  </head>
  <body>
    <SiteHeader />

    <main class:list={['site-main', { 'site-main--article': type === 'article' }]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
