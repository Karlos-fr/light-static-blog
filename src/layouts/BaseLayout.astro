---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { siteConfig } from '../config/site';
import { getAbsoluteUrl, getCanonicalUrl, getPath } from '../lib/urls';

interface Props {
  title: string;
  description?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
  previousUrl?: string;
  nextUrl?: string;
}

const {
  title,
  description = '',
  type = 'website',
  structuredData,
  previousUrl,
  nextUrl,
} = Astro.props as Props;
const canonicalUrl = getCanonicalUrl(Astro.url.pathname);
const serializedStructuredData = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : undefined;
---

<!doctype html>
<html lang="fr" data-theme={siteConfig.theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <script src={getPath('scripts/color-mode-init.js')} is:inline></script>
    <link rel="stylesheet" href={getPath('styles/theme.css')} />
    <script src={getPath('scripts/color-mode-toggle.js')} defer is:inline></script>
    <link rel="canonical" href={canonicalUrl} />
    {previousUrl ? <link rel="prev" href={previousUrl} /> : null}
    {nextUrl ? <link rel="next" href={nextUrl} /> : null}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {serializedStructuredData ? (
      <script type="application/ld+json" set:html={serializedStructuredData} is:inline />
    ) : null}
    <link rel="alternate" type="application/rss+xml" title="Flux RSS" href={getAbsoluteUrl('rss.xml')} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={getAbsoluteUrl('sitemap.xml')} />
  </head>
  <body>
    <SiteHeader />

    <main class:list={['site-main', { 'site-main--article': type === 'article' }]}>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
