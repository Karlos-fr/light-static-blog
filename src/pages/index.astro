---
import ArticleIndex from '../components/ArticleIndex.astro';
import { siteConfig } from '../config/site';
import { getPublicPosts } from '../lib/content';
import { paginateItems } from '../lib/pagination';
import { getAuthorName } from '../lib/site';
import { getAbsoluteUrl } from '../lib/urls';

const posts = await getPublicPosts();
const page = paginateItems(posts, 1, siteConfig.postsPerPage);
const siteUrl = getAbsoluteUrl();
const author = {
  '@type': 'Person',
  '@id': `${siteUrl}#author`,
  name: getAuthorName(),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${siteUrl}#website`,
  url: siteUrl,
  name: siteConfig.name,
  description: siteConfig.description,
  inLanguage: 'fr',
  author,
};
---

<ArticleIndex
  posts={page.items}
  currentPage={page.currentPage}
  totalPages={page.totalPages}
  structuredData={structuredData}
/>
