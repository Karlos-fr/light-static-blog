---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getPublicPosts } from '../lib/content';

const posts = await getPublicPosts();

---

<BaseLayout title="Accueil - Light Static Blog" description="Blog personnel sur le code, les jeux rétro et le bricolage technique">
  <h1>Bienvenue</h1>
  <p>Un blog personnel simple, orienté projet, notes techniques et petites expérimentations.</p>

  <section>
    <h2>Articles</h2>
    <PostList
      posts={posts}
      emptyMessage="Aucun article publié pour le moment."
      headingLevel="h3"
    />
  </section>
</BaseLayout>
