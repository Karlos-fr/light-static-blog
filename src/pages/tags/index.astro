---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/content';

const tags = await getAllTags();
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Tags" description="Liste des tags du blog.">
  <h1>Tags</h1>

  {tags.length === 0 ? (
    <p>Aucun tag pour le moment.</p>
  ) : (
    <ul>
      {tags.map((tag) => (
        <li>
          <a href={`${base}tags/${tag}`}>{tag}</a>
        </li>
      ))}
    </ul>
  )}

  <p><a href={`${base}blog`}>← retour aux articles</a></p>
</BaseLayout>
