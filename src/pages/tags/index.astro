---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllTags } from '../../lib/content';
import { getPath } from '../../lib/urls';

const tags = await getAllTags();
---

<BaseLayout title="Tags" description="Liste des tags du blog.">
  <h1>Tags</h1>

  {tags.length === 0 ? (
    <p>Aucun tag pour le moment.</p>
  ) : (
    <ul class="tag-index">
      {tags.map((tag) => (
        <li>
          <a class="tag-chip" href={getPath('tags', tag)}>{tag}</a>
        </li>
      ))}
    </ul>
  )}

  <p class="back-link"><a href={getPath('blog')}>← retour aux articles</a></p>
</BaseLayout>
