---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import {
  getAllTags,
  getPublicPostsByTag,
  getDisplayTag,
} from '../../lib/content';
import { getPath } from '../../lib/urls';

export async function getStaticPaths() {
  const tags = await getAllTags();

  return tags.map((tag) => ({
    params: { tag },
    props: { tag },
  }));
}

type Props = {
  tag: string;
};

const { tag } = Astro.props as Props;
const posts = await getPublicPostsByTag(tag);

---

<BaseLayout title={`Tag: ${getDisplayTag(tag)} | Light Static Blog`} description={`Articles taggés ${getDisplayTag(tag)}.`}>
  <h1>Tag : {getDisplayTag(tag)}</h1>

  <PostList
    posts={posts}
    emptyMessage="Aucun article pour ce tag."
    showTags={false}
  />

  <p class="back-link"><a href={getPath('tags')}>← retour aux tags</a></p>
</BaseLayout>
