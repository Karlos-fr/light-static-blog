---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCover from '../../components/PostCover.astro';
import PostMeta from '../../components/PostMeta.astro';
import TagList from '../../components/TagList.astro';
import { getPublicPosts } from '../../lib/content';
import { getPath } from '../../lib/urls';

export async function getStaticPaths() {
  const posts = await getPublicPosts();

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

type Props = {
  post: Awaited<ReturnType<typeof getPublicPosts>>[number];
};

const { post } = Astro.props as Props;
const { Content } = await post.render();

---

<BaseLayout
  title={`${post.data.title} | Light Static Blog`}
  description={post.data.description}
  type="article"
>
  <article class="article-content">
    <h1>{post.data.title}</h1>
    {post.data.cover ? (
      <PostCover cover={post.data.cover} title={post.data.title} />
    ) : null}
    <PostMeta
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      variant="article"
    />
    <TagList tags={post.data.tags} />

    <Content />
  </article>

  <p class="back-link"><a href={getPath('blog')}>← retour au blog</a></p>
</BaseLayout>
