---
/**
 * Pages paginées de la liste d'articles.
 *
 * La première page reste l'accueil ; cette route ne génère que les pages 2 et
 * suivantes pour éviter les doublons d'URL.
 */
import ArticleIndex from '../../components/ArticleIndex.astro';
import { siteConfig } from '../../config/site';
import { getPublicPosts } from '../../lib/content';
import { getPageCount, paginateItems } from '../../lib/pagination';
import { getAbsolutePageUrl } from '../../lib/urls';

/** Déclare à Astro les pages de pagination à générer. */
export async function getStaticPaths() {
  const posts = await getPublicPosts();
  const totalPages = getPageCount(posts.length, siteConfig.postsPerPage);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
    props: { posts, currentPage: index + 2 },
  }));
}

/** Props transmises à chaque page paginée. */
interface Props { posts: Awaited<ReturnType<typeof getPublicPosts>>; currentPage: number; }

/** Articles complets et numéro de page courant. */
const { posts, currentPage } = Astro.props as Props;

/** Tranche d'articles affichée sur cette page. */
const page = paginateItems(posts, currentPage, siteConfig.postsPerPage);

/** URL absolue et JSON-LD de la page de collection. */
const pageUrl = getAbsolutePageUrl('page', String(currentPage));
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': `${pageUrl}#collection`,
  url: pageUrl,
  name: `Articles - Page ${currentPage}`,
  description: siteConfig.description,
  inLanguage: 'fr',
  isPartOf: {
    '@id': `${getAbsolutePageUrl()}#website`,
  },
};
---

<ArticleIndex
  posts={page.items}
  currentPage={page.currentPage}
  totalPages={page.totalPages}
  structuredData={structuredData}
/>
