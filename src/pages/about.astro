---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
---

<BaseLayout title={`À propos | ${siteConfig.name}`} description="Présentation courte du projet de blog.">
  <h1>À propos</h1>
  <p>
    C'est un blog personnel pensé pour partager des idées, des notes techniques,
    des portages de jeux rétro et des bricolages utiles, sans surcouches inutiles.
  </p>
  <p>
    L'objectif est simple : publier vite, lire bien, garder une base propre et
    toujours statique.
  </p>
</BaseLayout>

