---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import PostCover from '../components/PostCover.astro';
import PostMeta from '../components/PostMeta.astro';
import TagList from '../components/TagList.astro';
import { siteConfig } from '../config/site';
import { getPublicPosts } from '../lib/content';
import { getAuthorName } from '../lib/site';
import { getAbsoluteUrl, getPath } from '../lib/urls';

export async function getStaticPaths() {
  const posts = await getPublicPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
}

type Props = {
  post: Awaited<ReturnType<typeof getPublicPosts>>[number];
  newerPost?: Awaited<ReturnType<typeof getPublicPosts>>[number];
  olderPost?: Awaited<ReturnType<typeof getPublicPosts>>[number];
};

const { post, newerPost, olderPost } = Astro.props as Props;
const { Content } = await post.render();
const siteUrl = getAbsoluteUrl();
const articleUrl = getAbsoluteUrl(post.slug);
const author = {
  '@type': 'Person',
  '@id': `${siteUrl}#author`,
  name: getAuthorName(),
};
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: articleUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  isPartOf: {
    '@id': `${siteUrl}#website`,
  },
  author,
  publisher: author,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: 'fr',
  keywords: post.data.tags.join(', '),
  ...(post.data.cover ? { image: getAbsoluteUrl(post.data.cover) } : {}),
};
---

<BaseLayout
  title={`${post.data.title} | ${siteConfig.name}`}
  description={post.data.description}
  type="article"
  structuredData={structuredData}
  previousUrl={newerPost ? getAbsoluteUrl(newerPost.slug) : undefined}
  nextUrl={olderPost ? getAbsoluteUrl(olderPost.slug) : undefined}
>
  <article class="article-content">
    <h1>{post.data.title}</h1>
    {post.data.cover ? (
      <PostCover cover={post.data.cover} title={post.data.title} />
    ) : null}
    <PostMeta
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      variant="article"
    />
    <TagList tags={post.data.tags} />

    <Content />
  </article>

  <ArticleNavigation newerPost={newerPost} olderPost={olderPost} />

  <p class="back-link"><a href={getPath()}>← retour au blog</a></p>
</BaseLayout>
