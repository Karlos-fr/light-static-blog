---
/**
 * Page détail d'un article.
 *
 * Génère une page statique par article public, avec contenu Markdown rendu,
 * données structurées BlogPosting et navigation précédent/suivant.
 */
import { render } from 'astro:content';

import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleNavigation from '../components/ArticleNavigation.astro';
import PostCover from '../components/PostCover.astro';
import PostMeta from '../components/PostMeta.astro';
import TagList from '../components/TagList.astro';
import { siteConfig } from '../config/site';
import { getPublicPosts } from '../lib/content';
import { getAuthorName } from '../lib/site';
import { getAbsolutePageUrl, getAbsoluteUrl, getPagePath } from '../lib/urls';

/** Déclare à Astro toutes les routes d'articles à générer. */
export async function getStaticPaths() {
  const posts = await getPublicPosts();

  return posts.map((post, index) => ({
    params: { slug: post.slug },
    props: {
      post,
      newerPost: posts[index - 1],
      olderPost: posts[index + 1],
    },
  }));
}

/** Props reçues depuis getStaticPaths pour la page article courante. */
type Props = {
  post: Awaited<ReturnType<typeof getPublicPosts>>[number];
  newerPost?: Awaited<ReturnType<typeof getPublicPosts>>[number];
  olderPost?: Awaited<ReturnType<typeof getPublicPosts>>[number];
};

/** Article courant et voisins chronologiques. */
const { post, newerPost, olderPost } = Astro.props as Props;

/** Composant HTML généré depuis le Markdown de l'article. */
const { Content } = await render(post);

/** URLs absolues utilisées par le SEO et le JSON-LD. */
const siteUrl = getAbsolutePageUrl();
const articleUrl = getAbsolutePageUrl(post.slug);

/** Auteur configuré au build et réutilisé dans les métadonnées. */
const authorName = getAuthorName();

/** Entité JSON-LD représentant l'auteur et l'éditeur. */
const author = {
  '@type': 'Person',
  '@id': `${siteUrl}#author`,
  name: authorName,
};
/** Données structurées BlogPosting propres à l'article. */
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.data.title,
  description: post.data.description,
  url: articleUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  isPartOf: {
    '@id': `${siteUrl}#website`,
  },
  author,
  publisher: author,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  inLanguage: 'fr',
  keywords: post.data.tags.join(', '),
  ...(post.data.cover ? { image: getAbsoluteUrl(post.data.cover) } : {}),
};
---

<BaseLayout
  title={`${post.data.title} | ${siteConfig.name}`}
  description={post.data.description}
  type="article"
  structuredData={structuredData}
  previousUrl={newerPost ? getAbsolutePageUrl(newerPost.slug) : undefined}
  nextUrl={olderPost ? getAbsolutePageUrl(olderPost.slug) : undefined}
  image={post.data.cover}
  publishedTime={post.data.pubDate}
  modifiedTime={post.data.updatedDate ?? post.data.pubDate}
  authorName={authorName}
  tags={post.data.tags}
>
  <article class="article-content">
    <h1>{post.data.title}</h1>
    {post.data.cover ? (
      <PostCover cover={post.data.cover} title={post.data.title} />
    ) : null}
    <PostMeta
      pubDate={post.data.pubDate}
      updatedDate={post.data.updatedDate}
      variant="article"
    />
    <TagList tags={post.data.tags} />

    <Content />
  </article>

  <ArticleNavigation newerPost={newerPost} olderPost={olderPost} />

  <p class="back-link"><a href={getPagePath()}>← retour à l'accueil</a></p>
</BaseLayout>
