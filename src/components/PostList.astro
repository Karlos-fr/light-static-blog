---
import type { BlogEntry } from '../lib/content';
import { getPath } from '../lib/urls';
import PostCover from './PostCover.astro';
import PostMeta from './PostMeta.astro';
import TagList from './TagList.astro';

interface Props {
  posts: BlogEntry[];
  emptyMessage: string;
  headingLevel?: 'h2' | 'h3';
  showTags?: boolean;
}

const {
  posts,
  emptyMessage,
  headingLevel = 'h2',
  showTags = true,
} = Astro.props as Props;
const Heading = headingLevel;
---

{posts.length === 0 ? (
  <p>{emptyMessage}</p>
) : (
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        {post.data.cover ? (
          <PostCover
            cover={post.data.cover}
            title={post.data.title}
            href={getPath('blog', post.slug)}
          />
        ) : null}
        <Heading class="post-title">
          <a href={getPath('blog', post.slug)}>{post.data.title}</a>
        </Heading>
        <PostMeta pubDate={post.data.pubDate} description={post.data.description} />
        {showTags ? <TagList tags={post.data.tags} /> : null}
      </li>
    ))}
  </ul>
)}
