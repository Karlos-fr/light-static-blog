---
/**
 * Liste de cartes d'articles.
 *
 * Le composant affiche les couvertures, tags, titres, descriptions et métadonnées
 * des articles en laissant les thèmes contrôler entièrement la présentation.
 */
import type { BlogEntry } from '../lib/content';
import { getTagAccent, normalizeTag } from '../lib/content';
import { getPagePath } from '../lib/urls';
import PostCover from './PostCover.astro';
import PostMeta from './PostMeta.astro';

/** Données nécessaires au rendu d'une liste d'articles. */
interface Props {
  posts: BlogEntry[];
  emptyMessage: string;
  headingLevel?: 'h2' | 'h3';
}

/** Props de liste, avec un niveau de titre configurable pour préserver le SEO. */
const {
  posts,
  emptyMessage,
  headingLevel = 'h2',
} = Astro.props as Props;
/** Composant de titre dynamique h2/h3 selon le contexte de page. */
const Heading = headingLevel;
---

{posts.length === 0 ? (
  <p>{emptyMessage}</p>
) : (
  <ul class="post-list">
    {posts.map((post, index) => {
      const primaryTag = post.data.tags[0];
      return (
      <li
        class="post-card"
        data-has-cover={post.data.cover ? 'true' : 'false'}
        data-accent={primaryTag ? getTagAccent(primaryTag) : 'primary'}
      >
        {post.data.cover ? (
          <PostCover
            cover={post.data.cover}
            title={post.data.title}
            href={getPagePath(post.slug)}
            eager={index === 0}
          />
        ) : null}
        <div class="post-card-content">
          <ul class="post-card-tags" aria-label="Tags de l’article">
            {post.data.tags.map((tag) => (
              <li>
                <a
                  class="post-category"
                  data-accent={getTagAccent(tag)}
                  href={getPagePath('tags', normalizeTag(tag))}
                >
                  {tag}
                </a>
              </li>
            ))}
          </ul>
          <Heading class="post-title">
            <a href={getPagePath(post.slug)}>{post.data.title}</a>
          </Heading>
          <p class="post-description">{post.data.description}</p>
          <div class="post-card-footer">
            <PostMeta pubDate={post.data.pubDate} />
            <span class="post-card-footer-separator" aria-hidden="true">•</span>
            <a class="read-more" href={getPagePath(post.slug)} aria-label={`Lire la suite de « ${post.data.title} »`}>
              Lire la suite →
            </a>
          </div>
        </div>
      </li>
      );
    })}
  </ul>
)}
