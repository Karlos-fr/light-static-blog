---
import { getImageDimensions } from '../lib/images';
import { getPath } from '../lib/urls';

interface Props {
  cover: string;
  title: string;
  href?: string;
  eager?: boolean;
}

const { cover, title, href, eager = false } = Astro.props as Props;
const src = getPath(cover);
const alt = `Couverture de l’article « ${title} »`;
const dimensions = getImageDimensions(cover);
const loading = eager ? 'eager' : 'lazy';
const fetchpriority = eager ? 'high' : undefined;
---

{href ? (
  <div class="post-cover-wrapper">
    <a class="cover-link" href={href} aria-label={`Lire ${title}`}>
      <img
        class="post-cover"
        src={src}
        alt={alt}
        loading={loading}
        fetchpriority={fetchpriority}
        width={dimensions?.width}
        height={dimensions?.height}
      />
    </a>
  </div>
) : (
  <div class="post-cover-wrapper">
    <img
      class="post-cover"
      src={src}
      alt={alt}
      width={dimensions?.width}
      height={dimensions?.height}
    />
  </div>
)}
