---
/**
 * Navigation de pagination des listes d'articles.
 *
 * Le composant reste volontairement générique et ne connaît que la page courante
 * et le nombre total de pages.
 */
import { getPagePath } from '../lib/urls';

/** État minimal nécessaire pour générer les liens précédent/suivant. */
interface Props { currentPage: number; totalPages: number; }

/** Props de pagination fournies par la page appelante. */
const { currentPage, totalPages } = Astro.props as Props;

/** Construit le chemin canonique d'une page paginée. */
const pagePath = (page: number) => page === 1 ? getPagePath() : getPagePath('page', String(page));
---

{totalPages > 1 ? (
  <nav class="pagination" aria-label="Pagination des articles">
    <ul class="pagination-list">
      <li>{currentPage > 1 ? <a href={pagePath(currentPage - 1)} rel="prev">← Précédente</a> : null}</li>
      <li class="pagination-current" aria-current="page">Page {currentPage} sur {totalPages}</li>
      <li>{currentPage < totalPages ? <a href={pagePath(currentPage + 1)} rel="next">Suivante →</a> : null}</li>
    </ul>
  </nav>
) : null}
