---
import { getPath } from '../lib/urls';

const projectUrl = 'https://github.com/Karlos-fr/light-static-blog';
---

<footer class="site-footer">
  <nav aria-label="Liens complémentaires">
    <ul>
      <li>
        <a class="rss-link" href={getPath('rss.xml')}>
          <span class="rss-icon" aria-hidden="true"></span>
          RSS
        </a>
      </li>
      <li class="footer-separator" aria-hidden="true">/</li>
      <li>
        <a class="powered-link" href={projectUrl} target="_blank" rel="noopener noreferrer">
          <img
            class="powered-icon"
            src={getPath('images/light-static-blog-icon.png')}
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="1254"
            height="1254"
          />
          Propulsé par Light Static Blog
        </a>
      </li>
    </ul>
  </nav>
</footer>
