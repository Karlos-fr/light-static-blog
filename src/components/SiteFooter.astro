---
/**
 * Pied de page commun.
 *
 * Il expose le flux RSS et le lien de crédit vers le projet Light Static Blog.
 */
import { getPath } from '../lib/urls';
import { getPackageVersion } from '../lib/site';

/** URL publique du dépôt source de la solution. */
const projectUrl = 'https://github.com/Karlos-fr/light-static-blog';

/** Version du moteur affichée en aide contextuelle du lien de crédit. */
const projectVersion = getPackageVersion();

/** Libellé accessible enrichi sans alourdir le texte visible du footer. */
const poweredLabel = `Propulsé par Light Static Blog version ${projectVersion}`;
---

<footer class="site-footer">
  <nav aria-label="Liens complémentaires">
    <ul>
      <li>
        <a class="rss-link" href={getPath('rss.xml')}>
          <span class="rss-icon" aria-hidden="true"></span>
          RSS
        </a>
      </li>
      <li class="footer-separator" aria-hidden="true">/</li>
      <li>
        <a
          class="powered-link"
          href={projectUrl}
          target="_blank"
          rel="noopener noreferrer"
          title={`Light Static Blog ${projectVersion}`}
          aria-label={poweredLabel}
        >
          <img
            class="powered-icon"
            src={getPath('images/light-static-blog-icon.png')}
            alt=""
            aria-hidden="true"
            loading="lazy"
            width="1254"
            height="1254"
          />
          Propulsé par Light Static Blog
        </a>
      </li>
    </ul>
  </nav>
</footer>
