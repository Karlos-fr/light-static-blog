---
/**
 * En-tête commun du site.
 *
 * Il affiche l'identité éditoriale, la navigation principale et les actions
 * utilitaires, tout en posant le H1 sur la page d'accueil.
 */
import { siteConfig } from '../config/site';
import { getPagePath } from '../lib/urls';
import ColorModeSwitch from './ColorModeSwitch.astro';

/** Chemin courant normalisé pour comparer les routes malgré les slashs finaux. */
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

/** Chemins de référence des entrées de navigation principales. */
const homePath = getPagePath().replace(/\/+$/, '') || '/';
const tagsPath = getPagePath('tags').replace(/\/+$/, '');
const aboutPath = getPagePath('about').replace(/\/+$/, '');

/** États actifs de navigation utilisés par aria-current. */
const isHome = currentPath === homePath;
const isArticles = currentPath === homePath
  || (!currentPath.startsWith(tagsPath) && currentPath !== aboutPath);
---

<header class="site-header">
  <nav class="site-nav" aria-label="Navigation principale">
    <div class="site-identity">
      {isHome ? (
        <h1 class="brand-heading">
          <a href={getPagePath()} class="brand" aria-current="page">{siteConfig.name}</a>
        </h1>
      ) : (
        <a href={getPagePath()} class="brand">{siteConfig.name}</a>
      )}
      {siteConfig.tagline ? <p class="site-tagline">{siteConfig.tagline}</p> : null}
    </div>
    <div class="site-nav-actions">
      <ul class="site-links">
        <li><a href={getPagePath()} aria-current={isArticles ? 'page' : undefined}>Articles</a></li>
        <li><a href={getPagePath('tags')} aria-current={currentPath.startsWith(tagsPath) ? 'page' : undefined}>Tags</a></li>
        <li><a href={getPagePath('about')} aria-current={currentPath === aboutPath ? 'page' : undefined}>À propos</a></li>
      </ul>
      <div class="site-utility-actions">
        <ColorModeSwitch />
      </div>
    </div>
  </nav>
</header>
