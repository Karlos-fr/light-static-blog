---
/**
 * Navigation entre articles voisins.
 *
 * Affiche les liens vers l'article plus récent et l'article plus ancien sur une
 * page article, avec les relations HTML prev/next.
 */
import type { BlogEntry } from '../lib/content';
import { getPagePath } from '../lib/urls';

/** Articles voisins éventuels autour de l'article courant. */
interface Props {
  newerPost?: BlogEntry;
  olderPost?: BlogEntry;
}

/** Props de navigation calculées par la page article. */
const { newerPost, olderPost } = Astro.props as Props;
---

{newerPost || olderPost ? (
  <nav class="article-navigation" aria-label="Navigation entre articles">
    {newerPost ? (
      <a class="article-navigation-link article-navigation-link--newer" href={getPagePath(newerPost.slug)} rel="prev">
        <span class="article-navigation-label">Article plus récent</span>
        <span class="article-navigation-title">← {newerPost.data.title}</span>
      </a>
    ) : (
      <span></span>
    )}

    {olderPost ? (
      <a class="article-navigation-link article-navigation-link--older" href={getPagePath(olderPost.slug)} rel="next">
        <span class="article-navigation-label">Article plus ancien</span>
        <span class="article-navigation-title">{olderPost.data.title} →</span>
      </a>
    ) : null}
  </nav>
) : null}
