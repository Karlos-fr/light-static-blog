---
import { siteConfig } from '../config/site';
import type { BlogEntry } from '../lib/content';
import { getPath } from '../lib/urls';
import BaseLayout from '../layouts/BaseLayout.astro';
import Pagination from './Pagination.astro';
import PostList from './PostList.astro';

interface Props {
  posts: BlogEntry[];
  currentPage: number;
  totalPages: number;
  structuredData?: Record<string, unknown>;
}

const { posts, currentPage, totalPages, structuredData } = Astro.props as Props;
const title = currentPage === 1
  ? siteConfig.homeMetaTitle
  : `Articles - Page ${currentPage} | ${siteConfig.name}`;
const previousUrl = currentPage > 1
  ? (currentPage === 2 ? getPath() : getPath('page', String(currentPage - 1)))
  : undefined;
const nextUrl = currentPage < totalPages
  ? getPath('page', String(currentPage + 1))
  : undefined;
const Heading = currentPage === 1 ? 'h2' : 'h1';
const postHeadingLevel = currentPage === 1 ? 'h3' : 'h2';
---

<BaseLayout
  title={title}
  description={siteConfig.description}
  structuredData={structuredData}
  previousUrl={previousUrl}
  nextUrl={nextUrl}
>
  {currentPage === 1 ? (
    <header class="home-intro">
      <h1>{siteConfig.homeTitle}</h1>
      <p>{siteConfig.description}</p>
    </header>
  ) : null}
  <Heading class="article-index-title">Articles{currentPage > 1 ? ` — Page ${currentPage}` : ''}</Heading>
  <PostList
    posts={posts}
    emptyMessage="Aucun article publié pour le moment."
    headingLevel={postHeadingLevel}
  />
  <Pagination currentPage={currentPage} totalPages={totalPages} />
</BaseLayout>
