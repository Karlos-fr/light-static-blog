<header>
  <nav class="site-nav">
    <a href="/" class="brand">Light Blog</a>
    <div class="links">
      <a href="/">Accueil</a>
      <a href="/blog">Blog</a>
      <a href="/tags">Tags</a>
      <a href="/about">À propos</a>
    </div>
  </nav>

  <style>
    .site-nav {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      justify-content: space-between;
      padding: 1rem;
      border-bottom: 1px solid var(--border);
      background: var(--surface);
      box-shadow: var(--shadow);
    }

    .brand {
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.03em;
    }

    .links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .links a {
      text-decoration: none;
      color: var(--text);
      padding: 0.15rem 0;
      border-bottom: 1px solid transparent;
    }

    .links a:hover,
    .links a:focus-visible {
      border-bottom-color: var(--link);
    }

    @media (max-width: 640px) {
      .site-nav {
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
      }

      .links {
        width: 100%;
      }
    }
  </style>
</header>
