---
import { getPath } from '../lib/urls';
---

<header class="site-header">
  <nav class="site-nav">
    <a href={getPath()} class="brand">Light Blog</a>
    <div class="links">
      <a href={getPath()}>Articles</a>
      <a href={getPath('tags')}>Tags</a>
      <a href={getPath('about')}>À propos</a>
      <a href={getPath('rss.xml')}>RSS</a>
      <a href={getPath('sitemap.xml')}>Sitemap</a>
    </div>
  </nav>

  <style>
    .site-nav {
      width: min(100% - 2rem, var(--max-width));
      margin: 0 auto;
      display: flex;
      gap: 0.75rem;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 0;
    }

    .site-header {
      border-bottom: 1px solid var(--border);
      background: var(--surface);
    }

    .brand {
      font-weight: 700;
      text-decoration: none;
      letter-spacing: 0.03em;
    }

    .links {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .links a {
      text-decoration: none;
      color: var(--text);
      padding: 0.15rem 0;
      border-bottom: 1px solid transparent;
    }

    .links a:hover,
    .links a:focus-visible {
      border-bottom-color: var(--link);
    }

    @media (max-width: 640px) {
      .site-nav {
        width: min(100% - 1.25rem, var(--max-width));
        flex-direction: column;
        align-items: flex-start;
        gap: 0.6rem;
      }

      .links {
        width: 100%;
        gap: 0.75rem 1rem;
      }
    }
  </style>
</header>
